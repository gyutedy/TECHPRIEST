{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy4-flash-free",
  "default_agent": "techpriest",
  "instructions": ["RITES.md", "AGENTS.md"],
  "permission": {
    "bash": {
      "git push *": "ask",
      "gh workflow run *": "ask",
      "modal run *": "ask",
      "rm -rf *": "deny"
    },
    "edit": {
      "TECHPRIEST/**": "deny",
      ".opencode/**": "deny",
      "ops/**": "deny"
    }
  }
}
